NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# "local" or "server" — shows a colored badge in the topbar
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_ENV_LABEL=LOCAL

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:sabarinathan.ravindran@gmail.com

# WhatsApp Cloud API (Meta for Developers)
# WHATSAPP_VERIFY_TOKEN — any secret string you choose; enter it in Meta webhook setup
# WHATSAPP_ACCESS_TOKEN — permanent token from System User in Meta Business Manager
# WHATSAPP_PHONE_NUMBER_ID — found in WhatsApp Manager > Phone Numbers
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=694983870354081

# Instagram API with Instagram login (Meta app MyBuddyCRM → Instagram use case)
# INSTAGRAM_ACCESS_TOKEN — generated token for the shop account (insights, comments, private-reply DMs)
# INSTAGRAM_VERIFY_TOKEN — any secret string you choose; enter it in Meta webhook setup
# INSTAGRAM_APP_SECRET — "Instagram app secret" from API setup; used to verify webhook signatures
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_VERIFY_TOKEN=your-verify-token
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# YouTube comment auto-replies (Google Cloud → OAuth client, type Web; redirect URI <site>/api/youtube/callback)
# YOUTUBE_POLL_SECRET — any secret string; Supabase pg_cron sends it as Bearer to /api/youtube/poll
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_POLL_SECRET=your-poll-secret
